# Equipment Management — production settings for ONE organisation's deployment.
#
# Copy to ".env" in this directory and fill in every value. ".env" is
# git-ignored: never commit it, never paste it into a ticket or chat.
# Restrict it on the server:  chmod 600 .env
# If your client profile ships clients/<profile>/deploy/.env.example, copy that
# file instead: it already holds the profile's fixed values.
#
# Values are deliberately EMPTY here. The API refuses to start in Production
# while a required value is missing or still holds example text, and it lists
# every problem in one message (docker compose logs api).
#
# A value containing "$" or "#" must be wrapped in single quotes.

# --- Client profile ------------------------------------------------------------
# Which clients/<profile>/ directory both images are built with (docs/WHITE_LABEL.md).
# Empty: clients/active-profile.txt when present, otherwise "default" (the
# neutral demonstration profile). When set, the API refuses to start if its
# image was built with any other profile.
CLIENT_PROFILE=

# Optional prefix of this deployment's containers, images and volumes.
# Default: equipment-management.
COMPOSE_PROJECT_NAME=

# --- Site --------------------------------------------------------------------
# Public host name only, no scheme and no path, e.g. equipment.example.com.
# DNS must point at this server before the first start (Caddy requests the TLS
# certificate for it). The stack derives from it:
#   App__PublicBaseUrl = https://<APP_DOMAIN>   (link in the retirement-request email)
#   AllowedHosts       = <APP_DOMAIN>;localhost
APP_DOMAIN=

# Optional label for the built images (e.g. the release tag). Default: local.
APP_VERSION=

# --- Database ----------------------------------------------------------------
# Used by the postgres container and to build ConnectionStrings__Default
# (Host=postgres;Port=5432;Database=...;Username=...;Password=...).
# Use a long random password made of letters and digits only: it is placed
# inside a connection string, where ";" and quotes have a meaning.
POSTGRES_DB=equipment_management
POSTGRES_USER=equipment_management
POSTGRES_PASSWORD=

# --- Document issuer ---------------------------------------------------------
# The organisation's registered legal identity, printed on every Responsibility Term.
Documents__Issuer__LegalName=
Documents__Issuer__Address=
Documents__Issuer__TaxId=

# --- SMTP --------------------------------------------------------------------
# TlsMode: StartTls (usual for port 587) or SslOnConnect (usual for port 465).
# None sends mail unencrypted and is logged as a warning on every start.
# Username and Password: set both, or leave both empty for an anonymous relay.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__TlsMode=StartTls
Email__Smtp__Username=
Email__Smtp__Password=
# Sender identity: the responsible HR person's corporate mailbox (the same
# account the SMTP credentials above authenticate as) and their display name.
# ReplyToAddress: leave empty to use FromAddress; set it only for another
# approved mailbox.
Email__Smtp__FromAddress=
Email__Smtp__FromDisplayName=
Email__Smtp__ReplyToAddress=

# --- Email signature -----------------------------------------------------------
# Appended to the emails sent to Consultants (Responsibility Term, dispatch,
# collection), one value per line, under the message's own closing line.
# All three are required; use the same person as the sender above.
Email__Signature__Name=
Email__Signature__Role=
Email__Signature__Company=

# --- First administrator (first deployment only) -----------------------------
# Set Enabled=true and the four values for the very first start, confirm the
# administrator can sign in, then set Enabled=false, blank the password and
# run "docker compose up -d api". Password: at least 12 characters, with
# upper case, lower case and a digit. See README.md, "First deployment".
BootstrapAdmin__Enabled=false
BootstrapAdmin__Email=
BootstrapAdmin__FirstName=
BootstrapAdmin__LastName=
BootstrapAdmin__Phone=
BootstrapAdmin__Password=

# --- Fixed by compose.yml (listed for reference; do not set here) ------------
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__Default        built from POSTGRES_* above
# PrivateStorage__RootPath=/data/private-storage         volume: private-storage
# DataProtection__KeyRingPath=/data/dataprotection-keys  volume: dataprotection-keys
# App__PublicBaseUrl=https://<APP_DOMAIN>
# AllowedHosts=<APP_DOMAIN>;localhost
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownProxies__0=172.30.84.2          the web (Caddy) container
