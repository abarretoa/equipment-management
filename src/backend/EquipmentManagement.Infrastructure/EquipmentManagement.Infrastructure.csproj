<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Needed for ASP.NET Core Identity/Authentication/Authorization types
      (cookie auth, IAuthorizationHandler, etc.) without pulling in the full
      Microsoft.NET.Sdk.Web hosting model, which belongs only to the Api project.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EquipmentManagement.Domain\EquipmentManagement.Domain.csproj" />
    <ProjectReference Include="..\EquipmentManagement.Application\EquipmentManagement.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets unit tests exercise a handful of pure private helpers directly (e.g. ResponsibilityTermPdfGenerator's text-wrapping logic) without widening their production visibility. -->
    <InternalsVisibleTo Include="EquipmentManagement.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Responsibility Term PDF generation (Phase 6). MIT-licensed, explicit
      net10.0 target, cross-platform (Linux-safe for the Docker deployment
      target) — see ADR-045 for the licensing evaluation that
      ruled out QuestPDF (revenue-gated Community license) and iText (AGPL).
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!--
      Outbound SMTP for the Phase 7 Responsibility Term delivery email
      (Phase 7 hardening pass). Replaces System.Net.Mail.SmtpClient, which
      Microsoft explicitly does not recommend for new development (no modern
      auth/protocol support). MIT-licensed, explicit net10.0 dependency group,
      no open unpatched security advisory at this pinned version — see the
      ADR on this choice for the exact verification (nuspec license, .NET 10
      compatibility, GitHub security-advisory check) performed before adding
      it. MimeKit is pinned explicitly even though it is also a transitive
      MailKit dependency, because Infrastructure code references its types
      (MimeMessage/MailboxAddress/BodyBuilder) directly.
    -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!--
      Security override, not used directly. MimeKit (net10.0 group: 10.0.0)
      and PDFsharp-MigraDoc (8.0.1) both depend on System.Security.Cryptography.Pkcs,
      and every version through 10.0.12 is affected by GHSA-846f-f764-76mx
      (High) and GHSA-2fmv-rv2c-59x7 (Moderate); 10.0.13 is the first patched
      .NET 10 release. Even the latest MimeKit/PDFsharp still request a
      vulnerable version, so this pin is what lifts the resolved version.
      Remove it once both packages depend on a patched version themselves.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      Consultant/Equipment Excel import-export (Phase 8). MIT-licensed, built
      on Microsoft's own DocumentFormat.OpenXml SDK (also MIT, explicit
      net10.0 dependency group) — every transitive dependency verified MIT/
      Apache-2.0, no open security advisory on either GitHub repo at the
      pinned versions. See ADR-055 for the full verification.
      No Excel/COM automation — reads/writes .xlsx without Excel installed.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Liberation Sans (Regular/Bold), bundled so PDF text rendering never
      depends on fonts installed on the host machine (required for Docker/
      Linux deployment — PDFsharp's cross-platform package has no implicit OS
      font access). SIL Open Font License 1.1 — see LICENSE-LiberationFonts-OFL-1.1.txt
      in the same folder; explicitly designed for free embedding/redistribution,
      including in commercial closed-source software.
    -->
    <EmbeddedResource Include="Documents\Fonts\LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Documents\Fonts\LiberationSans-Bold.ttf" />
    <None Include="Documents\Fonts\LICENSE-LiberationFonts-OFL-1.1.txt" />
  </ItemGroup>

  <!--
    The selected client profile (ClientProfile / ClientProfileDir come from
    Directory.Build.props), embedded so the built assembly carries exactly one
    profile: its two JSON files and its document/ folder, nothing else (the
    profile's frontend, assets and deploy folders are not part of the API).
    The assembly metadata both records which profile was embedded and makes a
    profile switch recompile this assembly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(ClientProfileDir)profile.json;$(ClientProfileDir)responsibility-term.json"
                      LogicalName="ClientProfile/%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="$(ClientProfileDir)document\**\*"
                      LogicalName="ClientProfile/document/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ClientProfile</_Parameter1>
      <_Parameter2>$(ClientProfile)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="EnsureClientProfileExists" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ClientProfileDir)profile.json')"
           Text="Client profile '$(ClientProfile)' not found: $(ClientProfileDir)profile.json does not exist. See docs/WHITE_LABEL.md." />
  </Target>

</Project>
