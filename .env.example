# Copy this file to `.env` for local development. `.env` is git-ignored — never
# commit real credentials. These defaults are for a throwaway local PostgreSQL
# container only and must never be reused anywhere else.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY. Production uses
# deploy/production/.env.example (docs/DEPLOYMENT.md). The placeholder values
# below are rejected at startup when ASPNETCORE_ENVIRONMENT=Production.

POSTGRES_DB=equipment_management
POSTGRES_USER=equipment_management
POSTGRES_PASSWORD=equipment_management_dev_only
POSTGRES_PORT=5432

# Bootstrap the first Administration user (README, "Local development").
# Disabled by default. These are obviously fake examples: the Production
# startup validation refuses the ".invalid" email and the "Replace-With"
# password. Disable it again once the account exists.
BootstrapAdmin__Enabled=false
BootstrapAdmin__Email=admin.bootstrap@example.invalid
BootstrapAdmin__FirstName=Change
BootstrapAdmin__LastName=Me
BootstrapAdmin__Phone=+351900000000
BootstrapAdmin__Password=Replace-With-A-Real-Secret-20+chars

# Legal issuer identity printed on generated Responsibility Term PDFs. There is
# NO fabricated default: if any of the three is missing, generation fails
# safely with a clear error instead of printing a blank or made-up issuer.
# A real deployment uses the organisation's registered legal name, address and
# tax ID. The term's wording itself comes from the client profile
# (docs/WHITE_LABEL.md) and needs the organisation's own legal review.
Documents__Issuer__LegalName=Example Consulting, Lda. (REPLACE — not a real company)
Documents__Issuer__Address=Rua Exemplo 123, 1000-001 Lisboa (REPLACE — not a real address)
Documents__Issuer__TaxId=000000000

# SMTP used to send Responsibility Terms and notifications. There is NO
# fabricated default: if Host/FromAddress are missing, a send attempt is
# recorded as a Failed delivery (never a fabricated Sent). Any SMTP provider
# works; swapping providers is a configuration change only. Automated tests
# never use this: an in-memory fake stands in, so no test sends a real email.
#
# Email__Smtp__TlsMode is one of: None (no TLS — local test relay only, never
# a real deployment), StartTls (port 587; REQUIRES the STARTTLS upgrade, never
# falls back to plaintext), SslOnConnect (implicit TLS, port 465). Certificate
# validation is never disabled by this application.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__TlsMode=StartTls
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=equipamentos@example-consulting.invalid (REPLACE — not a real address)
Email__Smtp__FromDisplayName=Example Consulting — Gestão de Equipamentos (REPLACE)
Email__Smtp__ReplyToAddress=

# Forwarded-header handling for a TLS-terminating reverse proxy. Disabled by
# default: enable it only if a reverse proxy in front of the API sets
# X-Forwarded-For/X-Forwarded-Proto. When enabled, KnownProxies or
# KnownNetworks MUST be set too — the app refuses to start otherwise, rather
# than trusting forwarded headers from an unspecified source (a spoofable
# client IP defeats rate limiting; a spoofable scheme defeats HTTPS/Secure
# cookie guarantees).
ForwardedHeaders__Enabled=false
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__0=

# The application's own public URL (scheme+host[+port], no trailing slash),
# used only to build the link in the retirement-request notification email.
# Never hardcoded in application code; if unset, the email is still sent
# without that link. Local development: usually left unset. Production: MUST
# be the real https:// URL of the deployment (e.g. https://equipment.example.com).
App__PublicBaseUrl=

# Where uploaded photos, generated Responsibility Terms and signed documents
# are stored. Local development: leave unset to use `private-storage/` under
# the API project (git-ignored). Production: REQUIRED, an absolute path on a
# persistent volume (the Docker package sets /data/private-storage).
# PrivateStorage__RootPath=

# Where the keys that encrypt the session and CSRF cookies are kept. Local
# development: leave unset (the framework's per-user default is used).
# Production: REQUIRED, an absolute path on a persistent volume, so users stay
# signed in across a redeploy (the Docker package sets
# /data/dataprotection-keys).
# DataProtection__KeyRingPath=
